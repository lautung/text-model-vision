# text-model-vision 配置示例 / Configuration example
# 也可以不建 .env，改为设置环境变量 DASHSCOPE_API_KEY（见 README）/ Or skip .env and set the DASHSCOPE_API_KEY environment variable instead (see README)
# 复制本文件为 .env 后填入你自己的值 / Copy this file to .env and fill in your own values:
#   Copy-Item .env.example .env
#
# 获取 Key：https://bailian.console.aliyun.com/
# 密钥仅保存在本地，切勿提交到仓库 / Keep the key local, never commit it.

DASHSCOPE_API_KEY=sk-your-api-key-here
VISION_MODEL=qwen-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
